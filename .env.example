# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
SERVICE_NAME=semantic-video-search
LLM_PROVIDER=gemini
SPEECH_PROVIDER=faster-whisper
EMBEDDING_PROVIDER=ollama

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/semantic_video_search?appName=VideoRAG-Studio
MONGODB_DB_NAME=semantic_video_search
VECTOR_SEARCH_INDEX_NAME=vector_index
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=30000

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

# ─── Faster Whisper (Local) ───────────────────────────────────────────────────
FASTER_WHISPER_MODEL=Xenova/whisper-base
FASTER_WHISPER_TIMEOUT_MS=300000

# ─── Local Embedding ──────────────────────────────────────────────────────────
LOCAL_EMBEDDING_MODEL=Xenova/nomic-embed-text-v1.5

# ─── Ollama Embedding ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Local LLM ────────────────────────────────────────────────────────────────
LOCAL_LLM_HOST=http://localhost:11434
LOCAL_LLM_MODEL=llama3
LOCAL_LLM_TIMEOUT_MS=120000

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=3600

# ─── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_DELAY_MS=1000
PIPELINE_RETRY_BACKOFF_MULTIPLIER=2
PIPELINE_TIMEOUT_MS=600000
PIPELINE_MAX_CONCURRENT=5
CHECKPOINT_ENABLED=true
CHECKPOINT_DIR=.checkpoints

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_THREADS=4

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here
