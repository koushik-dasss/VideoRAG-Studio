# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
SERVICE_NAME=semantic-video-search

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/semantic_video_search
MONGODB_DB_NAME=semantic_video_search
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=30000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_MS=60000

# ─── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

# ─── Whisper ──────────────────────────────────────────────────────────────────
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1
FASTER_WHISPER_HOST=http://localhost:9000
FASTER_WHISPER_TIMEOUT_MS=300000

# ─── Local LLM ────────────────────────────────────────────────────────────────
LOCAL_LLM_HOST=http://localhost:11434
LOCAL_LLM_MODEL=llama3
LOCAL_LLM_TIMEOUT_MS=120000

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=3600

# ─── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_DELAY_MS=1000
PIPELINE_RETRY_BACKOFF_MULTIPLIER=2
PIPELINE_TIMEOUT_MS=600000
PIPELINE_MAX_CONCURRENT=5
CHECKPOINT_ENABLED=true
CHECKPOINT_DIR=.checkpoints

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_THREADS=4

# ─── Metrics ──────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
