{
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist-test",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@errors/*": ["src/errors/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@models/*": ["src/models/*"],
      "@dto/*": ["src/dto/*"],
      "@validators/*": ["src/validators/*"],
      "@providers/*": ["src/providers/*"],
      "@services/*": ["src/services/*"],
      "@pipeline/*": ["src/pipeline/*"],
      "@utils/*": ["src/utils/*"],
      "@middleware/*": ["src/middleware/*"],
      "@events/*": ["src/events/*"],
      "@metrics/*": ["src/metrics/*"],
      "@cache/*": ["src/cache/*"],
      "@prompts/*": ["src/prompts/*"],
      "@plugins/*": ["src/plugins/*"],
      "@health/*": ["src/health/*"]
    }
  },
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
